# Copy this file to .env and fill in real values. Never commit .env.
# This is the FRONTEND repo — only put values that are safe to ship to the
# browser (NEXT_PUBLIC_* / REACT_APP_*) or that are used solely by Next.js
# server routes under src/pages/api. No SMTP / mail credentials belong here.

# --- API Configuration ---
# LOCAL: http://localhost:4000/api   |   LIVE: https://api.chooseyourtherapist.in/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_BASE_API=http://localhost:4000

# CRA compatibility (same values as above)
REACT_APP_API_URL=http://localhost:4000/api
REACT_APP_BASE_API=http://localhost:4000

# --- Google Maps (browser key) ---
# Public by nature. MUST be restricted in Google Cloud Console by HTTP referrer
# (chooseyourtherapist.in, localhost) and to the Maps JS + Geocoding APIs only.
REACT_APP_GOOGLE_MAPS_API_KEY=

# --- Razorpay ---
# Handled entirely by the backend API server. Order creation and payment
# verification happen there; the secret key never touches the frontend.
# The backend's /create-razorpay-order returns { orderId, keyId } and the
# browser uses that keyId to open Razorpay checkout.
# Do NOT add NEXT_PUBLIC_RAZORPAY_KEY_ID or RAZORPAY_KEY_SECRET here.

# --- Email ---
# Handled entirely by the backend API from hello@chooseyourtherapist.in.
# Do NOT add EMAIL_USER / EMAIL_PASS or any SMTP config here.
